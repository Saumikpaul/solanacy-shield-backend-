# ─────────────────────────────────────────────
# Security Audit Tool - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Flask
SECRET_KEY=your-super-secret-key-here
DEBUG=False
PORT=5000

# CORS - comma separated frontend URLs
ALLOWED_ORIGINS=https://yourdomain.netlify.app

# Gemma 4 via Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMMA_MODEL=gemma-4-31b-it

# Google Safe Browsing API (free)
SAFE_BROWSING_API_KEY=your-safe-browsing-key-here

# Firebase Admin SDK (fill when ready)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=your-key-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_CLIENT_ID=your-client-id
